#!/usr/bin/env bash
# Pretty git log. Used by `git l`, `l5`, `l10`, `last`, `local`, `since-last-tag`.
#
# * 51c333e    (12 days)    <Gary Bernhardt>   add vim-eunuch
#
# The time massaging regexes start with ^[^<]* so they only operate before the
# first "<" (the author name). A "}" in a field will break column alignment.

HASH="%C(always,white)%h%C(always,reset)"
RELATIVE_TIME="%C(always,blue)(%ar)%C(always,reset)"
AUTHOR="%C(always,blue)<%an>%C(always,reset)"
REFS="%C(always,green)%d%C(always,reset)"
SUBJECT="%s"

FORMAT="$HASH}$RELATIVE_TIME}$AUTHOR}$REFS $SUBJECT"

git log --graph --pretty="tformat:${FORMAT}" "$@" |
  # Replace (2 years ago) with (2 years)
  sed -Ee 's/(^[^<]*) ago\)/\1)/' |
  # Replace (2 years, 5 months) with (2 years)
  sed -Ee 's/(^[^<]*), [[:digit:]]+ .*months?\)/\1)/' |
  column -s '}' -t |
  less -FXRS
