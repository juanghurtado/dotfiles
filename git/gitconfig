[core]
  excludesfile = ~/.gitignore
  pager = less
  ignorecase = false
[alias]
  pr = !"$HOME/.dotfiles/bin/git-pr"
  st    = status -sb
  ci    = commit
  cm    = commit -m
  amend = commit --amend
  co    = checkout
  br    = branch -v
  brd   = branch -D
  undo  = reset --soft HEAD^
  unmerged  = diff --name-only --diff-filter=U
  untracked = ls-files --other --exclude-standard
  ignored   = ls-files --ignored --exclude-standard
  wip = !git add --all . && git commit -m 'WIP' --no-verify
  unwip = undo
  fp = push --force-with-lease origin HEAD
  amv = !git commit --amend -C HEAD
  amn = !git commit --amend -C HEAD --no-verify
  p = push -u origin HEAD

  files = diff-tree --no-commit-id --name-only -r

  l5    = !git l --max-count=5
  l10   = !git l --max-count=10
  l20   = !git l --max-count=20
  last  = !git l -1
  local = !git l `git rev-parse --symbolic-full-name --abbrev-ref HEAD@{u}`..HEAD

  prev-branch = !git co -
  clean-local-branches = !"$HOME/.dotfiles/bin/git-clean-local-branches"

  since-last-tag   = !git l `git describe --tags --abbrev=0`..HEAD
  archive-last-tag = !git archive --format=zip `git describe --tags --abbrev=0` > `git describe --tags --abbrev=0`.zip
  assume = update-index --assume-unchanged
  unassume = update-index --no-assume-unchanged
[color]
  branch      = auto
  diff        = auto
  interactive = auto
  status      = auto
  ui          = auto
[apply]
  whitespace = nowarn
[push]
  default = simple
  autoSetupRemote = true
[fetch]
  prune = true
[init]
  defaultBranch = main
[include]
  path = ~/.gitconfig.local
[branch]
  sort = -committerdate
